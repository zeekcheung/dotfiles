// chezmoi:template: left-delimiter="// [[" right-delimiter="]]"

// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

{
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 18,
  "agent_buffer_font_size": 16,
  "agent_ui_font_size": 16,
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 18,
  "buffer_font_features": {
    "calt": true
  },
  "text_rendering_mode": "platform_default",
  "soft_wrap": "none",
  "preferred_line_length": 120,
  "colorize_brackets": true,
  "relative_line_numbers": "enabled",
  "gutter": {
    "min_line_number_digits": 2
  },
  "document_folding_ranges": "on",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed"
  },
  "sticky_scroll": {
    "enabled": true
  },
  "semantic_tokens": "combined",
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true
    }
  },
  "inlay_hints": {
    "enabled": true
  },
  "diff_view_style": "unified",
  "minimap": {
    "show": "auto"
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_branch_name": true,
    "show_project_items": true,
    "show_sign_in": true,
    "show_user_menu": true,
    "show_user_picture": true,
    "show_onboarding_banner": false
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "code_actions": true,
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": false
  },
  "status_bar": {
    "active_language_button": true,
    "active_encoding_button": "enabled",
    "cursor_position_button": true,
    "line_endings_button": true
  },
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_from_file_finder": true
  },
  "project_panel": {
    "dock": "left",
    "button": true,
    "entry_spacing": "comfortable",
    "auto_fold_dirs": false,
    "hide_root": false,
    "bold_folder_labels": false
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "file_icons": true
  },
  "search": {
    "button": true
  },
  "debugger": {
    "button": true
  },
  "collaboration_panel": {
    "button": false
  },
  "outline_panel": {
    "dock": "right"
  },
  "terminal": {
    "shell": {
      "program": "nu"
    },
    "working_directory": "current_project_directory",
    "blinking": "on",
    "copy_on_select": true,
    "line_height": "standard",
    "toolbar": {
      "breadcrumbs": false
    },
    "font_features": {
      "calt": true
    }
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 200
  },
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "use_system_clipboard": "always"
  },
  "tab_size": 2,
  "use_smartcase_search": true,
  "languages": {
    "TypeScript": {
      "language_servers": ["tsgo", "oxlint", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "TSX": {
      "language_servers": ["tsgo", "oxlint", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "JavaScript": {
      "language_servers": ["tsgo", "oxlint", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    // "JSX": { "formatter": { "language_server": { "name": "oxfmt" } } },
    // "Vue.js": { "formatter": { "language_server": { "name": "oxfmt" } } },
    // "Astro": { "formatter": { "language_server": { "name": "oxfmt" } } },
    // "Svelte": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "CSS": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "SCSS": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "Less": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "HTML": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "Handlebars": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "JSON": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "JSONC": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "YAML": { "formatter": { "language_server": { "name": "oxfmt" } } },
    "Markdown": {
      "language_servers": ["marksman", "rumdl", "oxfmt"],
      // "prettier": { "allowed": true },
      "format_on_save": "on",
      "use_on_type_format": true,
      "remove_trailing_whitespace_on_save": true
    },
    "Python": {
      "tab_size": 4,
      "language_servers": ["ty", "ruff"]
    },
    "Lua": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--syntax=Lua54", "--respect-ignores", "--stdin-filepath", "{buffer_path}", "-"]
        }
      }
    },
    "Nu": { "formatter": { "external": { "command": "nufmt" } } }
  },
  "lsp": {
    // [[if eq .chezmoi.os "windows" -]]
    "powershell-es": {
      "binary": {
        "path": "pwsh",
        "arguments": [
          "-NoLogo",
          "-NoProfile",
          "-Command",
          "Import-Module $env:LOCAL_PSModulePath/PowerShellEditorServices/PowerShellEditorServices.psd1;",
          "Start-EditorServices",
          "-Stdio",
          "-HostName zed",
          "-HostProfileId zed",
          "-HostVersion 1.0.0",
          "-LogLevel Information",
          "-SessionDetailsPath $env:TEMP/zed-pses-session.json",
          "-LogPath $env:TEMP/zed-pses.log"
        ]
      }
    },
    // [[- end]]
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    }
  },
  "file_types": {
    "JSONC": ["*.cjson"],
    "TOML": ["*.toml.tmpl"],
    "ini": ["dot_ripgreprc"],
    "Git Config": ["dot_gitconfig"],
    "PowerShell": ["*.psd1"],
    "Shell Script": [
      "dot_bash_profile",
      "dot_bash_profile.tmpl",
      "dot_profile",
      "dot_profile.tmpl",
      "dot_shellrc",
      "dot_shellrc.tmpl"
    ]
  },
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "calls": {
    "mute_on_join": true
  },
  "auto_update": true,
  "auto_install_extensions": {
    "material-icon-theme": true,
    "editorconfig": true,
    "comment": true,
    "tsgo": true,
    "oxc": true,
    "lua": true,
    "nu": true,
    "toml": true,
    "tombi": true,
    "xml": true,
    "ini": true,
    "marksman": true,
    "rumdl": true,
    "log": true,
    "git-firefly": true
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed"
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "minimal",
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false
  }
}
